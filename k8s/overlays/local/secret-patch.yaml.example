# Copy this file to secret-patch.yaml (gitignored — never commit a real key)
# and fill in your OpenAI API key:
#
#   cp secret-patch.yaml.example secret-patch.yaml
#   # then edit OPENAI_API_KEY below
#
# A strategic merge patch, not secretGenerator+behavior:merge, for the same
# reason as configmap-patch.yaml — see that file's comment.
apiVersion: v1
kind: Secret
metadata:
  name: kaigi-secrets
  namespace: kaigi
type: Opaque
stringData:
  OPENAI_API_KEY: "sk-..."
