# ADDR — every service (moderator/discovery/persona) reads this for its own
# listen address. `make dev-*` targets set it per-process directly rather
# than through .env, since all four processes run on one machine and need
# different ports (moderator :8080, discovery :8081, persona-critic :8082,
# persona-pragmatist :8083) — see the Makefile.
ADDR=:8080

# Postgres — one instance, four logical databases (kaigi_meeting /
# kaigi_registry / kaigi_persona / kaigi_knowledge) — see config.DatabaseConfig.
# Each service derives its own DSN by appending /kaigi_<name> to this base URL.
POSTGRES_BASE_URL=postgres://postgres:kaigi@localhost:5432?sslmode=disable

# MinIO (S3-compatible object storage) — read by persona pods and seed only.
# The moderator and discovery never connect to MinIO.
MINIO_ENDPOINT=localhost:9000
# Only needs to differ from MINIO_ENDPOINT when the backend and the browser
# reach MinIO by different hostnames (e.g. an in-cluster name vs. localhost).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaigi-knowledge
MINIO_USE_SSL=false
# Supplied rather than discovered: the presign client would otherwise look the
# region up over the network against MINIO_PUBLIC_ENDPOINT, which the backend
# itself often cannot reach (in Docker that name resolves to its own loopback).
MINIO_REGION=us-east-1

# OpenAI (chat completions + embeddings share one key and base URL).
# Get a key at https://platform.openai.com/api-keys
# Read by persona pods and seed only — moderator and discovery never call
# OpenAI. cfg.Validate() refuses to start a persona pod or seed without this.
OPENAI_API_KEY=
# Must include the /v1 path segment.
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5-mini
# Must be a text-embedding-3 family model: the request always sends the
# dimensions parameter, and its width must match vector(1536) in SQL.
EMBED_MODEL=text-embedding-3-small

# Retrieval tuning — read by persona pods.
CANDIDATE_K=40
FINAL_N=8
# PERSONA_INFLUENCE is the lambda blending cosine-similarity relevance with
# persona interest affinity (0 = pure RAG, 1 = pure persona affinity).
PERSONA_INFLUENCE=0.25
CONTEXT_PAD_BYTES=1200
# A chunk is citable when its cosine similarity to the query clears
# RELEVANCE_FLOOR + RELEVANCE_SKEPTICISM_SPAN * persona.skepticism.
# These are empirical — recalibrate against your own corpus if recall looks
# too tight or too loose.
RELEVANCE_FLOOR=0.25
RELEVANCE_SKEPTICISM_SPAN=0.20

# Registry — where a persona pod registers itself, and where the moderator
# and a persona pod's own A2A dialer look up other agents' cards.
REGISTRY_URL=http://localhost:8081
# Heartbeat cadence a persona pod re-registers on. TTL must stay more than
# 2x the interval (config.ValidateRegistry enforces this) so one missed
# heartbeat doesn't flip a persona to "absent".
REGISTRY_HEARTBEAT_INTERVAL=15s
REGISTRY_TTL=45s

# This persona pod's own identity — cmd/persona only. Must match a slug
# seeded into kaigi_persona (see backend/cmd/seed/main.go) or the pod
# refuses to start.
PERSONA_SLUG=
# This pod's OWN address as reachable by OTHER pods (discovery resolving its
# card, the moderator dialing it) — never "localhost". In docker-compose
# this is the service name (e.g. http://persona-critic:8082); in k8s it's
# the Service FQDN.
A2A_PUBLIC_URL=

# Moderator — how many rounds a single meeting turn can run, at most,
# regardless of what the client requests.
MEETING_MAX_ROUNDS=3

# CORS — read by the moderator. Only matters when the frontend is served
# from a different origin than the moderator; the dev/compose/k8s setups
# here all proxy same-origin, so this rarely needs to change.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend dev server (read by frontend/vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8080
