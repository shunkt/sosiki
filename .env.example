# Backend (read by backend/cmd/server, backend/cmd/seed)
ADDR=:8080
ALLOWED_ORIGINS=http://localhost:5173

# Postgres (must have the pgvector extension; docker-compose.yml provides it)
DATABASE_URL=postgres://postgres:kaigi@localhost:5432/kaigi?sslmode=disable

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
# Only needs to differ from MINIO_ENDPOINT when the backend and the browser
# reach MinIO by different hostnames (e.g. an in-cluster name vs. localhost).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaigi-knowledge
MINIO_USE_SSL=false

# Text Embeddings Inference (ruri-v3 embedding + reranker containers)
EMBED_URL=http://localhost:8081
RERANK_URL=http://localhost:8082

# DeepSeek (OpenAI-compatible chat API). Get a key at https://platform.deepseek.com/
# The server refuses to start without this set — see config.Validate().
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash

# Retrieval tuning
CANDIDATE_K=40
FINAL_N=8
# PERSONA_INFLUENCE is the lambda blending cross-encoder relevance with
# persona interest affinity (0 = pure RAG, 1 = pure persona affinity).
PERSONA_INFLUENCE=0.25
CONTEXT_PAD_BYTES=1200

# Frontend dev server (read by frontend/vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8080
