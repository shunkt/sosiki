# node_modules is reinstalled from the lockfile inside the image; copying the
# host's copy would both bloat the build context and risk platform-specific
# binaries built for the host architecture.
node_modules

# Build output — regenerated by `npm run build` in the builder stage.
dist
dist-ssr

# Docker's own inputs are not build inputs. Caddyfile is NOT listed here:
# the runtime stage copies it into the image.
Dockerfile
.dockerignore

*.local
*.log
.DS_Store
